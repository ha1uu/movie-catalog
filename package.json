{
  "name": "kadr-movie-catalog",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0",
    "build": "nuxt build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "npm run build && playwright test",
    "test:perf": "node scripts/performance.mjs",
    "test:live": "node scripts/check-live.mjs",
    "doctor": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "nuxt": "3.21.11",
    "undici": "7.30.2",
    "vue": "3.5.45",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@fontsource/manrope": "5.2.8",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "sharp": "0.34.5",
    "typescript": "5.9.3",
    "vue-tsc": "3.2.6"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
