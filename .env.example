# Скопируйте этот файл в .env рядом с package.json.
# TMDB: https://www.themoviedb.org/settings/api -> API Read Access Token.
# Вставьте только токен, без слова Bearer; API Key (v3) сюда не подходит.
# После изменения .env перезапустите npm run dev или npm start.
# .env с настоящим токеном должен оставаться локальным и не попадать в Git.
NUXT_TMDB_READ_TOKEN=
NITRO_HOST=0.0.0.0
NITRO_PORT=3000
